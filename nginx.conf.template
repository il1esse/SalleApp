server {
    listen ${PORT};
    server_name _;
    # Port lu dans la variable d'environnement PORT au démarrage (3030 par défaut)
    root /usr/share/nginx/html;
    index index.html;

    gzip on;
    gzip_types text/css application/javascript application/manifest+json image/svg+xml application/json;
    gzip_min_length 512;

    # En-têtes de sécurité (aucun add_header dans les location, sinon ils seraient perdus)
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header X-Frame-Options "DENY" always;

    # Noms de fichiers non versionnés : le navigateur revalide toujours (Cache-Control: no-cache).
    # Le service worker gère le hors-ligne côté téléphone.
    location / {
        try_files $uri $uri/ /index.html;
        expires -1;
    }

    location ~ \.webmanifest$ {
        types { }
        default_type application/manifest+json;
        expires -1;
    }

    location /icons/ {
        expires 30d;
    }
}
